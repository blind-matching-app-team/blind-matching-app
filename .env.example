# MySQL
MYSQL_DATABASE=bma
MYSQL_USER=bma
MYSQL_PASSWORD=bma1234
MYSQL_ROOT_PASSWORD=root1234
MYSQL_PORT=3306

# Spring Boot
APP_PORT=8080
JWT_SECRET=change-this-development-secret-key-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (선택)
REDIS_PORT=6379

# 토스페이먼츠
# 키 발급: https://developers.tosspayments.com/my/api-keys
#
# 반드시 test_ 로 시작하는 테스트 키만 사용한다.
# live_ 키는 실제 금액이 청구되며, 운영 프로파일이 아닌 곳에 넣으면 기동이 중단된다(TossApiKeyGuard).
# 클라이언트 키와 시크릿 키는 세트로 발급되므로 섞어 쓰지 않는다(INVALID_API_KEY).
#
# 시크릿 키는 서버 전용이다. .env 는 .gitignore 대상이며 절대 커밋하지 않는다.
PAYMENT_GATEWAY=stub
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
