# MySQL
MYSQL_DATABASE=bma
MYSQL_USER=bma
MYSQL_PASSWORD=bma1234
MYSQL_ROOT_PASSWORD=root1234
MYSQL_PORT=3306

# Spring Boot
APP_PORT=8080
JWT_SECRET=change-this-development-secret-key-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (선택)
REDIS_PORT=6379

# 토스페이먼츠
# 키 발급: https://developers.tosspayments.com/my/api-keys
#
# 반드시 test_ 로 시작하는 테스트 키만 사용한다.
# live_ 키는 실제 금액이 청구되며, 운영 프로파일이 아닌 곳에 넣으면 기동이 중단된다(TossApiKeyGuard).
# 클라이언트 키와 시크릿 키는 세트로 발급되므로 섞어 쓰지 않는다(INVALID_API_KEY).
#
# 시크릿 키는 서버 전용이다. .env 는 .gitignore 대상이며 절대 커밋하지 않는다.
PAYMENT_GATEWAY=stub
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# 샌드박스 검증 스크립트용 테스트 카드 (BMA-23)
#   node backend/scripts/verify-toss-sandbox.js
#
# 토스는 테스트용 카드번호를 제공하지 않는다. 테스트 환경에서는 실제 카드 정보를
# 넣어도 가상 승인이라 출금되지 않는다.
# 다만 빌링키 발급은 앞 여섯 자리(BIN)만 유효하면 등록되므로,
# 본인 카드 앞 6자리 + 나머지 임의 숫자를 쓰면 실제 카드번호를 파일에 남기지 않아도 된다.
# 절차는 backend/docs/TOSS_SANDBOX_VERIFICATION.md 참고.
TOSS_TEST_CARD_NUMBER=
TOSS_TEST_CARD_EXPIRY_YEAR=30
TOSS_TEST_CARD_EXPIRY_MONTH=12
TOSS_TEST_CARD_IDENTITY=900101
TOSS_TEST_CARD_PASSWORD=00
TOSS_TEST_AMOUNT=1000

# 소셜 로그인 (BMA-35)
# 백엔드 콜백 방식이다. 3사 콘솔에 등록할 Redirect URI 는 아래 형태다.
#   http://localhost:8080/api/v1/auth/social/kakao/callback
#   http://localhost:8080/api/v1/auth/social/naver/callback
#   http://localhost:8080/api/v1/auth/social/google/callback
#
# 자격 증명이 비어 있는 제공자는 비활성으로 처리되어 요청 시 400 을 반환한다.
# 콘솔 등록이 끝난 것부터 하나씩 채우면 된다.
# 시크릿은 서버 전용이다. .env 는 .gitignore 대상이며 절대 커밋하지 않는다.
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# scope 를 비워두면 제공자 기본값을 쓴다.
# 카카오는 이메일(account_email)이 권한 필요 항목이라 비즈 앱 전환과 검수 전에는
# 요청 시 KOE205 로 거부된다. 승인 전까지는 profile_nickname 처럼 낮춰 두고,
# 승인 후 account_email 로 바꾸면 코드 수정 없이 전환된다.
OAUTH_KAKAO_SCOPE=
OAUTH_NAVER_SCOPE=
OAUTH_GOOGLE_SCOPE=

# 로그인 성공/실패 후 사용자를 돌려보낼 프론트 주소
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/result
OAUTH_FAILURE_REDIRECT=http://localhost:5173/oauth/result
