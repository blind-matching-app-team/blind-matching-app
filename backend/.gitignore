# ---------------------------------------------------------------------
# Gradle
# ---------------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.properties
# 전역 gitignore 가 *.jar 를 제외하는 경우가 많아 wrapper jar 는 명시적으로 포함시킨다.
# 이 파일이 없으면 CI 와 신규 합류자가 ./gradlew 를 쓸 수 없다.
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.classpath
.project
.settings/
bin/

# VS Code 는 공유할 설정만 커밋한다.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------------------------------------
# 애플리케이션 런타임 산출물
# ---------------------------------------------------------------------
# 로컬 저장소(STORAGE_ROOT 기본값). 업로드된 사용자 이미지는 절대 커밋하지 않는다.
uploads/
logs/
*.log

# ---------------------------------------------------------------------
# 비밀 값
# ---------------------------------------------------------------------
# JWT_SECRET, DB 비밀번호 등이 들어가는 파일. .env.example 만 커밋한다.
.env
.env.local
.env.*.local
application-local.yml
application-secret*.yml

# ---------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
