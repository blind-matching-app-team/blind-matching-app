m.expect(d.status).to.eql(\"WAITING\"); pm.expect(d.entrySource).to.eql(\"FREE\"); pm.expect(d.remainingSeconds).to.be.within(1, 300); pm.expect(d.expiresAt).to.be.a(\"string\"); pm.expect(d).to.have.property(\"matchId\", null); });","pm.collectionVariables.set(\"queueA\", d.queueId);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matching/queue","host":["{{baseUrl}}"],"path":["api","v1","matching","queue"]}}},{"name":"5. A 폴링 → WAITING","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"같은 queueId, waitedSeconds≥0\", () => { pm.expect(d.status).to.eql(\"WAITING\"); pm.expect(d.queueId).to.eql(pm.collectionVariables.get(\"queueA\")); pm.expect(d.waitedSeconds).to.be.at.least(0); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matching/queue","host":["{{baseUrl}}"],"path":["api","v1","matching","queue"]}}},{"name":"6. C 진입 → A 와 조건 불일치(둘 다 남) → WAITING","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.test(\"WAITING\", () => pm.expect(pm.response.json().data.status).to.eql(\"WAITING\"));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenC}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matching/queue","host":["{{baseUrl}}"],"path":["api","v1","matching","queue"]}}},{"name":"7. D(여·30·선호 남 ≤34) 가입","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.collectionVariables.set(\"userD\", pm.response.json().data.userId);"]}}],"request":{"me