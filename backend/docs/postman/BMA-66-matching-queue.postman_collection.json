ipt","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"MATCHED partner=A\", () => { pm.expect(d.status).to.eql(\"MATCHED\"); pm.expect(d.partnerUserId).to.eql(pm.collectionVariables.get(\"userA\")); pm.expect(d.matchId).to.be.a(\"number\"); pm.expect(d.chatRoomId).to.be.a(\"number\"); });","pm.collectionVariables.set(\"match1\", d.matchId); pm.collectionVariables.set(\"room1\", d.chatRoomId);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenD}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matching/queue","host":["{{baseUrl}}"],"path":["api","v1","matching","queue"]}}},{"name":"9. A 폴링 → MATCHED","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"같은 matchId·chatRoomId, partner=D, remaining 0\", () => { pm.expect(d.status).to.eql(\"MATCHED\"); pm.expect(d.matchId).to.eql(pm.collectionVariables.get(\"match1\")); pm.expect(d.chatRoomId).to.eql(pm.collectionVariables.get(\"room1\")); pm.expect(d.partnerUserId).to.eql(pm.collectionVariables.get(\"userD\")); pm.expect(d.remainingSeconds).to.eql(0); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matching/queue","host":["{{baseUrl}}"],"path":["api","v1","matching","queue"]}}},{"name":"10. C 폴링 → 여전히 WAITING","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.test(\"WAITING\", () => pm.expect(pm.response.json().data.status).to.eql(\"WAITING\"));"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenC}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matching/queue",