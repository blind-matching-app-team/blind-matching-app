e.status(400));"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"body":{"mode":"raw","raw":"{}"},"url":{"raw":"{{baseUrl}}/api/v1/users/me/password","host":["{{baseUrl}}"],"path":["api","v1","users","me","password"]}}},{"name":"10. 비밀번호 변경 성공 (S8-16)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"sessionsEnded=1, changedAt\", () => { pm.expect(d.sessionsEnded).to.eql(1); pm.expect(d.changedAt).to.be.a(\"string\"); });"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"body":{"mode":"raw","raw":"{\"currentPassword\":\"{{password}}\",\"newPassword\":\"{{newPassword}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/users/me/password","host":["{{baseUrl}}"],"path":["api","v1","users","me","password"]}}},{"name":"11. 옛 리프레시 토큰 재발급 → 401","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"refreshToken\":\"{{refreshA}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/refresh","host":["{{baseUrl}}"],"path":["api","v1","auth","refresh"]}}},{"name":"12. 옛 비밀번호 로그인 → 401","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{emailA}}\",\"password\":\"{{password}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/login","host":["{{baseUrl}}"],"path":["api","v1","auth","login"]}}},{"name":"13. 새 비밀번호 로그인 → 200","event":[{"listen":"test","script":{"type":"text/javascript",