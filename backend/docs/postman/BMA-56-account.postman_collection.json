lue":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA2}}"}],"body":{"mode":"raw","raw":"{\"refreshToken\":\"{{refreshA2}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/logout","host":["{{baseUrl}}"],"path":["api","v1","auth","logout"]}}},{"name":"25. 로그아웃한 리프레시 토큰 재발급 → 401","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"refreshToken\":\"{{refreshA2}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/refresh","host":["{{baseUrl}}"],"path":["api","v1","auth","refresh"]}}},{"name":"26. 로그아웃 후 액세스 토큰은 만료 전까지 유효 (문서 명시)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA2}}"}],"url":{"raw":"{{baseUrl}}/api/v1/users/me","host":["{{baseUrl}}"],"path":["api","v1","users","me"]}}},{"name":"27. 회원 탈퇴 (S8-15)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"userId=A, WITHDRAWN, matchesEnded=1, withdrawnAt\", () => { pm.expect(d.userId).to.eql(pm.collectionVariables.get(\"userA\")); pm.expect(d.status).to.eql(\"WITHDRAWN\"); pm.expect(d.matchesEnded).to.eql(1); pm.expect(d.withdrawnAt).to.be.a(\"string\"); });"]}}],"request":{"method":"DELETE","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/users/me","host":["{{baseUrl}}"],"path":["api","v1","users","me"]}}},{"name":"28. 탈퇴 후 로그인 → 401","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"]}}]