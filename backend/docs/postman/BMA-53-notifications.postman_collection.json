e}"},"url":{"raw":"{{baseUrl}}/api/v1/matches/{{matchId}}/reveal/consent","host":["{{baseUrl}}"],"path":["api","v1","matches","{{matchId}}","reveal","consent"]}}},{"name":"25. A 목록 - 알림 그대로 3건 (요청 알림 없음)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"3건, 최신은 MESSAGE_RECEIVED\", () => { pm.expect(d.content).to.have.lengthOf(3); pm.expect(d.content[0].eventCode).to.eql(\"MESSAGE_RECEIVED\"); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications?page=0&size=20","host":["{{baseUrl}}"],"path":["api","v1","notifications"],"query":[{"key":"page","value":"0"},{"key":"size","value":"20"}]}}},{"name":"26. B 매칭 그만두기 (S5-16)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}],"request":{"method":"DELETE","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenB}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matches/{{matchId}}","host":["{{baseUrl}}"],"path":["api","v1","matches","{{matchId}}"]}}},{"name":"27. A 목록 - 최신 MATCH_ENDED (S7-14, S5)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","const n = d.content[0];","pm.test(\"MATCH_ENDED, 제목, target S5, 상대 닉네임 없음\", () => { pm.expect(n.eventCode).to.eql(\"MATCH_ENDED\"); pm.expect(n.title).to.eql(\"매칭이 종료됐어요\"); pm.expect(n.target.screen).to.eql(\"S5\"); pm.expect(JSON.stringify(n)).to.not.include(pm.collectionVariables.get(\"nickB\")); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/