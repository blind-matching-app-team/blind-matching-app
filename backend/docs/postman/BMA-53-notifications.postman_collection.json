get(\"matchId\")); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications?page=0&size=20","host":["{{baseUrl}}"],"path":["api","v1","notifications"],"query":[{"key":"page","value":"0"},{"key":"size","value":"20"}]}}},{"name":"13. B 목록 - MATCH_CREATED 도착","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.test(\"MATCH_CREATED\", () => pm.expect(pm.response.json().data.content[0].eventCode).to.eql(\"MATCH_CREATED\"));"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenB}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications?page=0&size=20","host":["{{baseUrl}}"],"path":["api","v1","notifications"],"query":[{"key":"page","value":"0"},{"key":"size","value":"20"}]}}},{"name":"14. B 메시지 전송","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenB}}"}],"body":{"mode":"raw","raw":"{\"messageType\":\"TEXT\",\"content\":\"안녕하세요 반가워요\"}"},"url":{"raw":"{{baseUrl}}/api/v1/chat/rooms/{{roomId}}/messages","host":["{{baseUrl}}"],"path":["api","v1","chat","rooms","{{roomId}}","messages"]}}},{"name":"15. A 목록 - 최신 MESSAGE_RECEIVED (S11, chatRoomId, 미리보기)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","const n = d.content[0];","pm.test(\"MESSAGE_RECEIVED, type MESSAGE, target S11 chatRoomId, content 미리보기\", () => { pm.expect(n.eventCode).to.eql(\"MESSAGE_RECEIVED\"); pm.expect(n.type).to.eql(\"MESSAGE\"); pm.expect(n.target.screen).to.eql(\"S11\"); pm.expect(n.target.chatRoomId).to.eql(pm.collectionVariables.get(\"roomId\")); pm.expect(n.content).to.eql(\"안녕하세요 반가워요\"); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications?page=0&size=20","host":["{{baseUrl}}"],"path":["api","v1","notifications"],"query":[{"key":"page","value":"0"},{"key":"size","value":"20"}]}}},{"name":"16. A 안읽음 수 3","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.test(\"unreadCount=3\", () => pm.expect(pm.response.json().data.unreadCount).to.eql(3));"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications/unread-count","host":["{{baseUrl}}"],"path":["api","v1","notifications","unread-count"]}}},{"name":"17. A unreadOnly=true → 3건","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.test(\"3건\", () => pm.expect(pm.response.json().data.content).to.have.lengthOf(3));"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications?page=0&size=20&unreadOnly=true","host":["{{baseUrl}}"],"path":["api","v1","notifications"],"query":[{"key":"page","value":"0"},{"key":"size","value":"20"},{"key":"unreadOnly","value":"true"}]}}},{"name":"18. A 개별 읽음 (MATCH_LIKED)","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"notificationId 일치, readAt, unreadCount=2\", () => { pm.expect(d.notificationId).to.eql(pm.collectionVariables.get(\"likedId\")); pm.expect(d.readAt).to.be.a(\"string\"); pm.expect(d.unreadCount).to.eql(2); });","pm.collectionVariables.set(\"readAt\", d.readAt);"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications/{{likedId}}/read","host":["{{baseUrl}}"],"path":["api","v1","notifications","{{likedId}}","read"]}}},{"name":"19. 같은 알림 재읽음 - 멱등","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"readAt 그대로, unreadCount=2\", () => { pm.expect(d.readAt).to.eql(pm.collectionVariables.get(\"readAt\")); pm.expect(d.unreadCount).to.eql(2); });"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications/{{likedId}}/read","host":["{{baseUrl}}"],"path":["api","v1","notifications","{{likedId}}","read"]}}},{"name":"20. A unreadOnly=true → 2건","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.test(\"2건\", () => pm.expect(pm.response.json().data.content).to.have.lengthOf(2));"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/notifications?page=0&size=20&unreadOnly=true","host":["{{baseUrl}}"],"path":["api","v1","notifications"],"query":[{"key":"page","value":"0"},{"key":"size","value":"20"},{"key":"unreadOnly","value":"true"}]}}},{"name":"21. A 전체 목록 - 3건, 읽은 항목 read=true","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"3건, MATCH_LIKED read=true\", () => { pm.expect(d.content).to.have.lengthOf