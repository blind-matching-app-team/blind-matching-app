{
  "info": {
    "name": "BMA-38 온보딩 API",
    "description": "S2 온보딩 API 검증 컬렉션.\n\n계정 생성 → 질문 조회 → 관심사 제출(계층+우선순위) → 나머지 제출 → 완료 확인 순서로 실행한다.\nRunner 로 위에서부터 순서대로 실행해야 한다(앞 요청 결과를 뒤에서 쓴다).\n\n사전 조건: docker compose up -d --build\n\n검증 대상은 S2 사양서 v1.4 기준이다.\n- 관심사 대분류 → 세부 2단계 구조\n- 우선순위(드래그 정렬) 저장\n- 진행률은 문항이 아니라 구간(step) 기준\n- 온보딩 완료가 로그인 응답의 onboardingCompleted 에 반영되는지",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "onboard1234",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "interestQuestionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cultureOptionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "travelOptionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cultureChildId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherAnswers",
      "value": "",
      "type": "string"
    },
    {
      "key": "travelChildId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 계정 생성",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', 'onboarding-' + Date.now() + '@bma.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "signup"
          ]
        }
      }
    },
    {
      "name": "2. 로그인 - 온보딩 전 (onboardingCompleted=false)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().data;",
              "// 화면 흐름: S1 -> S2(온보딩) -> S3(프로필) -> 메인 허브.",
              "// 두 플래그가 독립이라 boolean 하나로는 중간 상태를 표현할 수 없다.",
              "pm.test('onboardingCompleted=false (S2 로 보내야 함)', () => pm.expect(t.onboardingCompleted).to.be.false);",
              "pm.test('profileCompleted=false', () => pm.expect(t.profileCompleted).to.be.false);",
              "pm.collectionVariables.set('accessToken', t.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "3. 질문 목록 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const qs = pm.response.json().data;",
              "pm.test('질문이 하나 이상 있다', () => pm.expect(qs.length).to.be.above(0));",
              "",
              "// S2 사양서 v1.4: 진행률 N/7 은 문항이 아니라 구간 기준이다.",
              "pm.test('모든 질문에 stepNo 가 배정돼 있다', () => {",
              "    qs.forEach(q => pm.expect(q.stepNo, q.questionText).to.be.above(0));",
              "});",
              "",
              "const interest = qs.find(q => q.categoryCode === 'INTEREST');",
              "pm.test('관심사 문항이 있다', () => pm.expect(interest).to.not.be.undefined);",
              "pm.test('관심사는 다중 선택(MULTI)', () => pm.expect(interest.questionType).to.eql('MULTI'));",
              "",
              "// S2-10/S2-11: 대분류 칩 아래 세부 관심사가 붙는다.",
              "const culture = interest.options.find(o => o.optionCode === 'CULTURE');",
              "const travel = interest.options.find(o => o.optionCode === 'TRAVEL');",
              "pm.test('대분류가 7개다', () => pm.expect(interest.options.length).to.eql(7));",
              "pm.test('대분류 아래 세부 항목이 계층으로 온다', () => {",
              "    pm.expect(culture.children.length).to.be.above(0);",
              "    pm.expect(travel.children.length).to.be.above(0);",
              "});",
              "pm.test('세부 항목은 최상위 목록에 섞이지 않는다', () => {",
              "    const codes = interest.options.map(o => o.optionCode);",
              "    pm.expect(codes).to.not.include('CULTURE_MOVIE');",
              "});",
              "",
              "// 내부 점수는 매칭 알고리즘 값이라 클라이언트에 노출하지 않는다.",
              "pm.test('보기에 내부 점수(scoreValue)가 없다', () => {",
              "    pm.expect(interest.options[0]).to.not.have.property('scoreValue');",
              "});",
              "",
              "pm.collectionVariables.set('interestQuestionId', interest.questionId);",
              "pm.collectionVariables.set('cultureOptionId', culture.optionId);",
              "pm.collectionVariables.set('travelOptionId', travel.optionId);",
              "pm.collectionVariables.set('cultureChildId', culture.children[0].optionId);",
              "pm.collectionVariables.set('travelChildId', travel.children[0].optionId);",
              "",
              "// 관심사 외 문항은 첫 보기를 골라 한 번에 제출한다.",
              "const others = qs.filter(q => q.categoryCode !== 'INTEREST')",
              "    .map(q => ({ questionId: q.questionId, optionId: q.options[0].optionId }));",
              "pm.collectionVariables.set('otherAnswers', JSON.stringify(others));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/onboarding/questions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "onboarding",
            "questions"
          ]
        }
      }
    },
    {
      "name": "4. 관심사 제출 (대분류 2개 + 세부 + 우선순위)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json().data;",
              "pm.test('4건 저장', () => pm.expect(r.savedCount).to.eql(4));",
              "// 관심사는 1구간이므로 전체 구간 중 1개만 완료된다.",
              "pm.test('1구간 완료', () => pm.expect(r.completedSteps).to.eql(1));",
              "pm.test('전체 완료는 아직 아니다', () => pm.expect(r.completed).to.be.false);",
              "pm.test('완료율이 0보다 크고 100 미만', () => {",
              "    pm.expect(r.completionRate).to.be.above(0);",
              "    pm.expect(r.completionRate).to.be.below(100);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": {{interestQuestionId}}, \"optionId\": {{cultureOptionId}}, \"rank\": 1 },\n    { \"questionId\": {{interestQuestionId}}, \"optionId\": {{travelOptionId}}, \"rank\": 2 },\n    { \"questionId\": {{interestQuestionId}}, \"optionId\": {{cultureChildId}} },\n    { \"questionId\": {{interestQuestionId}}, \"optionId\": {{travelChildId}} }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/onboarding/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "onboarding",
            "answers"
          ]
        }
      }
    },
    {
      "name": "5. 나머지 문항 제출 → 100%",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('answersJson', pm.collectionVariables.get('otherAnswers'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json().data;",
              "pm.test('모든 구간 완료', () => pm.expect(r.completedSteps).to.eql(r.totalSteps));",
              "pm.test('완료율 100%', () => pm.expect(r.completionRate).to.eql(100));",
              "pm.test('completed=true', () => pm.expect(r.completed).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": {{answersJson}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/onboarding/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "onboarding",
            "answers"
          ]
        }
      }
    },
    {
      "name": "6. 재로그인 - 온보딩 후 (S3 로 보내야 함)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().data;",
              "// 이 조합이 'S2 는 끝났고 S3 로 가야 한다' 를 뜻한다.",
              "pm.test('onboardingCompleted=true', () => pm.expect(t.onboardingCompleted).to.be.true);",
              "pm.test('profileCompleted=false (아직 S3 미완료)', () => pm.expect(t.profileCompleted).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "7. 인증 없이 답변 제출 (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401 (답변 제출은 인증 필요)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": {{interestQuestionId}}, \"optionId\": {{cultureOptionId}} }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/onboarding/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "onboarding",
            "answers"
          ]
        }
      }
    },
    {
      "name": "8. 존재하지 않는 질문 제출 (거부)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('4xx 로 거부', () => pm.expect(pm.response.code).to.be.within(400, 499));",
              "pm.test('success=false', () => pm.expect(pm.response.json().success).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": 999999, \"optionId\": {{cultureOptionId}} }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/onboarding/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "onboarding",
            "answers"
          ]
        }
      }
    },
    {
      "name": "9. 다른 질문의 보기 끼워넣기 (거부)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 보기가 해당 질문에 속하는지 검증하지 않으면 답변 데이터가 오염된다.",
              "pm.test('4xx 로 거부', () => pm.expect(pm.response.code).to.be.within(400, 499));",
              "pm.test('success=false', () => pm.expect(pm.response.json().success).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": {{interestQuestionId}}, \"optionId\": 999999 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/onboarding/answers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "onboarding",
            "answers"
          ]
        }
      }
    }
  ]
}
