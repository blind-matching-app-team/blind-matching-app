t(\"tokenB\", pm.response.json().data.accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{emailB}}\",\"password\":\"{{password}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/login","host":["{{baseUrl}}"],"path":["api","v1","auth","login"]}}},{"name":"21. B 회원 탈퇴","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}],"request":{"method":"DELETE","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenB}}"}],"url":{"raw":"{{baseUrl}}/api/v1/users/me","host":["{{baseUrl}}"],"path":["api","v1","users","me"]}}},{"name":"22. 탈퇴 계정 이메일 요청 → 같은 응답, 링크 없음","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","pm.test(\"sent=true, debugResetLink=null\", () => { pm.expect(d.sent).to.eql(true); pm.expect(d).to.have.property(\"debugResetLink\", null); });"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{emailB}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/password-reset/request","host":["{{baseUrl}}"],"path":["api","v1","auth","password-reset","request"]}}},{"name":"23. 대문자·공백 이메일도 정규화되어 발급","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","const d = pm.response.json().data;","const tok = (d.debugResetLink || \"\").split(\"token=\")[1];","pm.test(\"링크 발급\", () => pm.expect(tok).to.be.a(\"string\").and.not.empty);","pm.collectionVariables.set(\"token3\", tok);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"  {{emailA}}  \"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/password-reset/request","