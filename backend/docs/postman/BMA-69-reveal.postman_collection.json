utes).to.be.within(1380, 1440); pm.expect(d.reveal.requiredMessagesPerUser).to.eql(10); pm.expect(d.reveal.canRequest).to.eql(false); pm.expect(d.match.partner).to.have.property(\"nickname\", null); pm.expect(d.match.partner).to.have.property(\"nicknameMasked\", null); pm.expect(d.match.partner).to.have.property(\"heightCm\", null); pm.expect(d.rematchTickets).to.eql(0); });"]}}],"request":{"method":"GET","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenA}}"}],"url":{"raw":"{{baseUrl}}/api/v1/matches/{{match1}}","host":["{{baseUrl}}"],"path":["api","v1","matches","{{match1}}"]}}},{"name":"6. C(남, 비참여자) 가입","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.collectionVariables.set(\"userC\", pm.response.json().data.userId);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{emailC}}\",\"password\":\"{{password}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/signup","host":["{{baseUrl}}"],"path":["api","v1","auth","signup"]}}},{"name":"6. C(남, 비참여자) 로그인","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));","pm.collectionVariables.set(\"tokenC\", pm.response.json().data.accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{emailC}}\",\"password\":\"{{password}}\"}"},"url":{"raw":"{{baseUrl}}/api/v1/auth/login","host":["{{baseUrl}}"],"path":["api","v1","auth","login"]}}},{"name":"6. C(남, 비참여자) 프로필","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"]}}],"request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tokenC}}"}],"body":